[user]
# 	email = someone@gmail.com
#	name = Your Name
[color]
	ui = auto
[alias]
        # see `git help log` for detailed help.
        #   %h: abbreviated commit hash
        #   %d: ref names, like the --decorate option of git-log(1)
        #   %cn: commiter name
        #   %ce: committer email
        #   %cr: committer date, relative
        #   %ci: committer date, ISO 8601-like format
        #   %an: author name
        #   %ae: author email
        #   %ar: author date, relative
        #   %ai: author date, ISO 8601-like format
        #   %s: subject
        # my awesome git log command
	lol  = log --graph --pretty=format:\"%C(auto)%h%d%Creset %C(cyan)(%cr)%Creset %C(green)%an <%ae>%Creset %s\"
        # same as above, but ISO date
	lold = log --graph --pretty=format:\"%C(auto)%h%d%Creset %C(cyan)(%ci)%Creset %C(green)%an <%ae>%Creset %s\"
        # using build-in standards
	lol2 = log --oneline --graph --decorate
        # shows branches and their last commits
        lol3 = log --all --graph --decorate --oneline --simplify-by-decoration
        # dag = log --graph --format='format:%C(yellow)%h%C(reset) %C(green)\"%an\" <%ae>%C(reset) %C(cyan)%ar%C(reset)%C(auto)%d%C(reset)%n%s' --date-order
	co = checkout
	br = branch
        showa = show --format=fuller
        showf = show --name-only

[core]
	pager = "less -iS -#8 -FMRX"
	excludesfile = ~/.init.pub/git/gitignore_global

[push]
	default = simple
[pull]
	rebase = true
