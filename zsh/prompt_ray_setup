# Zsh prompt theme: ray
# Usage: prompt ray

# Smart-truncate the current directory for prompt display.
# Shows the full path when short, but when longer than 16 chars AND deeper
# than 4 levels, collapses the middle into a count of skipped segments.
#
# Examples:
#   ~/projects           -> ~/projects             (short, no change)
#   ~/a/b/c/d/e/f/g      -> ~/a/..5../f/g          (7 parts, skip middle)
#   /usr/local/share/man -> /usr/local/share/man   (4 parts, no collapse)
#   /opt/data/a/b/c/d/e  -> /opt/data/..3../d/e    (7 parts, skip middle)
#
# Replicates your MYPSDIR_AWK logic in native zsh
fancy_prompt_dir() {
  # Get path with ~ for home
  local p="${PWD/#$HOME/~}"
  # Split into an array
  local parts=("${(s:/:)p}")

  # Your specific condition: length > 16 AND more than 4 parts
  if [[ ${#p} -gt 16 && ${#parts} -gt 4 ]]; then
    # Replicates: print $1,$2,".." NF-4 "..",$(NF-1),$NF
    # Note: parts[1] is the first element in Zsh (1-based indexing)
    echo "${parts[1]}/${parts[2]}/..$((${#parts}-4))../${parts[-2]}/${parts[-1]}"
  else
    echo "$p"
  fi
}

prompt_ray_setup() {
  # set a prompt similar to my bash version for now
  # %(?.success.failure): ternary expression
  # %F{10}: Bright Green.
  # %F{9}: Bright Red.
  # %?: exit status
  # %l: tty
  # %L: shell level
  # %h: history number
  setopt PROMPT_SUBST
  PROMPT='[%F{yellow}%B%h%b%f %(?.%F{10}.%F{9})%?%f %l/%L %B%n@%m%b $(fancy_prompt_dir)]%# '
}

prompt_ray_cleanup() {
  unfunction fancy_prompt_dir 2>/dev/null
}